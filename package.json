{
  "name": "creator-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "browser:install": "playwright install chromium",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts",
    "db:transfer": "node --env-file-if-exists=.env --import tsx scripts/db-transfer.ts",
    "test:postgres": "node --import tsx --test tests/postgres.integration.ts",
    "test:smoke:postgres": "node --import tsx scripts/smoke.ts --postgres",
    "research:instagram": "node --env-file-if-exists=.env --import tsx scripts/research-instagram.ts",
    "test:instagram-browser": "node --import tsx scripts/test-instagram-browser.ts",
    "research:night": "node --env-file-if-exists=.env --import tsx scripts/research-night.ts",
    "test:night-browser": "node --import tsx scripts/test-night-browser.ts",
    "test:discovery-browser": "node --import tsx scripts/test-discovery-browser.ts",
    "test:http-browser": "node --import tsx scripts/test-http-restrictions.ts",
    "test:tag-browser": "node --import tsx scripts/test-tag-collection.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
