# Storage selector: sqlite (default) or postgres.
RADAR_STORAGE=sqlite
# Server-side PostgreSQL URL, direct or session pooler. Never use NEXT_PUBLIC_.
# Copy the exact URL from Supabase Connect; URL-encode special password characters.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Remote connections always verify TLS; local loopback defaults to disable.
# DATABASE_SSL=verify-full
# Optional PEM root CA path from your database provider:
# DATABASE_CA_FILE=/absolute/path/to/ca.pem

# Server and worker must use the same absolute path.
RADAR_DB=data/radar.sqlite
# One-click start opens the worker if needed. Set false only for an externally managed worker.
WORKER_AUTO_START=true
WORKER_HEARTBEAT_FILE=data/worker-heartbeat.json
BROWSER_SESSION_FILE=data/browser-session.json
BROWSER_PROFILE=data/chromium-research-profile
BROWSER_CHANNEL=chromium
# Only Chromium is accepted. Background research is always headless.
# Dedicated profile selection persists here and takes precedence over profile above.
BROWSER_PREFERENCES_FILE=data/browser-preferences.json
MAX_RECORDS=100
PAGE_TIMEOUT_MS=15000
MAX_HTML_BYTES=1000000
# Comma-separated exact hosts allowed for explicitly authorized collection.
# Generic permitted-page adapter only; Instagram uses dedicated research jobs.
AUTHORIZED_HOSTS=example.com

# Optional bounded Instagram public-profile research (no stealth or bypass).
INSTAGRAM_BROWSER_ENABLED=true
INSTAGRAM_MAX_PAGES=10
INSTAGRAM_DAILY_PAGES=0
INSTAGRAM_STATE_FILE=data/instagram-research-state.json

# Browser-based keyword discovery: no search API key required.
GOOGLE_DISCOVERY_STATE_FILE=data/google-discovery-state.json
GOOGLE_DISCOVERY_INTERVAL_SECONDS=30
GOOGLE_DISCOVERY_DAILY_QUERIES=20

INSTAGRAM_WAIT_MIN_SECONDS=10
INSTAGRAM_WAIT_MAX_SECONDS=30

# Minimum hours between automatic enrichment attempts on the same creator
ENRICHMENT_COOLDOWN_HOURS=4
